# Копія цього файлу з реальними значеннями має називатись .env.local
# і НІКОЛИ не потрапляє в git (див. .gitignore).

# Етап 2 (ядро даних) — підключення до бази PostgreSQL.
# Для локальної розробки достатньо будь-якої PostgreSQL (можна безкоштовну
# хмарну, напр. Neon чи Supabase) — підкажу конкретні кроки, коли дійдемо
# до цього.
DATABASE_URL="postgresql://user:password@host:5432/project_market"

# Етап 3 (автентифікація) — обов'язково для роботи входу/реєстрації.
# Згенерувати можна командою: npx auth secret
AUTH_SECRET=""

# Вхід через Google — отримати в Google Cloud Console (безкоштовно).
# Покроково — docs/auth.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Вхід через Apple — потребує платного Apple Developer Program ($99/рік).
# Покроково — docs/auth.md.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Етап 6 (угода) — оплата $1 (40 грн) за перегляд контактів через LiqPay.
# Без цих двох ключів застосунок сам зараховує оплату одразу (DEV_MOCK) —
# так можна перевірити всю механіку розблокування контактів ще ДО
# реєстрації мерчант-акаунта LiqPay. Покроково, коли будете готові
# підключати справжні платежі — docs/payments.md.
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""

# "false" — приймати справжні платежі (тільки коли акаунт LiqPay пройшов
# перевірку). Будь-яке інше значення (або відсутність змінної) — режим
# пісочниці (тестові картки LiqPay, гроші не списуються насправді).
LIQPAY_SANDBOX="true"

# Публічна адреса застосунку (без / в кінці) — потрібна LiqPay, щоб
# повернути людину назад на сторінку проєкту й надіслати серверне
# підтвердження оплати. Для локальної розробки не потрібна (LiqPay все
# одно не достукається до localhost) — обов'язкова лише на реальному
# сервері з публічною адресою.
APP_URL="https://project-market.example"
