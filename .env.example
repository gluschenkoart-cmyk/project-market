# Копія цього файлу з реальними значеннями має називатись .env.local
# і НІКОЛИ не потрапляє в git (див. .gitignore).

# Етап 2 (ядро даних) — підключення до бази PostgreSQL.
# Для локальної розробки достатньо будь-якої PostgreSQL (можна безкоштовну
# хмарну, напр. Neon чи Supabase) — підкажу конкретні кроки, коли дійдемо
# до цього.
DATABASE_URL="postgresql://user:password@host:5432/project_market"

# Етап 3 (автентифікація) — обов'язково для роботи входу/реєстрації.
# Згенерувати можна командою: npx auth secret
AUTH_SECRET=""

# Вхід через Google — отримати в Google Cloud Console (безкоштовно).
# Покроково — docs/auth.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Вхід через Apple — потребує платного Apple Developer Program ($99/рік).
# Покроково — docs/auth.md.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
