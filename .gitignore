# dependencies
/node_modules

# next.js build output
/.next/
/out/

# production
/build

# env files — реальні секрети та ключі ніколи не комітяться
.env
.env*.local

# завантажені файли проєктів (локальне тимчасове сховище, src/lib/storage.ts)
# — реальний контент користувачів, не код; у git не потрапляє
/public/uploads/*
!/public/uploads/.gitkeep

